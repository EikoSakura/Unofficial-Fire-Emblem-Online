<section class="tab panel-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="card supports">
    <h3>{{localize "FEO.Section.bonds"}}
      <span class="aside">{{#if editMode}}{{localize "FEO.Bond.kept" count=bonds.length}}{{else}}{{localize "FEO.Bond.rangeHint" range=config.supportRange}}{{/if}}</span>
    </h3>

    {{#if editMode}}
    {{!-- Edit mode: every partner the unit keeps a record of, each a name and a bar --}}
    {{#if supports.kept.length}}
    <div class="sup-row sup-scale" aria-hidden="true">
      <span></span><span></span>
      <span class="sup-marks">{{#each supports.scale as |mark|}}<i>{{localize mark}}</i>{{/each}}</span>
      <span></span><span></span><span></span>
    </div>
    {{/if}}
    {{#each supports.kept as |bond|}}
    <div class="sup-row" data-bond="{{bond.index}}">
      <div class="sup-who">
        {{#if bond.img}}<img class="sup-token" src="{{bond.img}}" alt="">{{else}}<span class="sup-token">{{feoIcon bond.icon}}</span>{{/if}}
        <b>{{#if bond.name}}{{bond.name}}{{else}}{{localize "FEO.Bond.unnamed"}}{{/if}}</b>
        <button type="button" class="sup-kin" data-action="kinBond" aria-pressed="{{bond.kin}}"
                data-tooltip="{{localize "FEO.Bond.kin"}}: {{localize "FEO.Bond.kinHint"}}" aria-label="{{localize "FEO.Bond.kin"}}">{{feoIcon "link"}}</button>
      </div>
      <button type="button" class="sup-step" data-action="stepBond" data-lower="true"
              data-tooltip="{{localize "FEO.Bond.lower"}}" aria-label="{{localize "FEO.Bond.lower"}}"{{#unless bond.canLower}} disabled{{/unless}}>{{feoIcon "minus"}}</button>
      <div class="sup-bar" data-tooltip="{{#if bond.ready}}{{localize "FEO.Bond.readyHint"}}{{else}}{{#if bond.pointsNext}}{{localize "FEO.Bond.progress" points=bond.points next=bond.pointsNext}}{{else}}{{localize bond.rankLabel}}{{/if}}{{/if}}">
        {{#each bond.steps as |step|}}<span><i style="width: {{step.pct}}%"></i></span>{{/each}}
      </div>
      <div class="sup-next">
        {{#if bond.canRaise}}
        <button type="button" class="sup-step up" data-action="stepBond" data-lower="false"
                data-tooltip="{{localize "FEO.Bond.raise"}}" aria-label="{{localize "FEO.Bond.raise"}}">{{feoIcon "plus"}}</button>
        {{/if}}
        {{#each bond.tops as |top|}}
        <button type="button" class="sup-top" data-action="topBond" data-to="{{top.rank}}"
                data-tooltip="{{localize top.hint}}"{{#unless top.usable}} disabled{{/unless}}>{{localize top.label}}</button>
        {{/each}}
      </div>
      <span class="sup-rank{{#if bond.level}} on{{/if}}">{{localize bond.rankLabel}}</span>
      <button type="button" class="remove" data-action="deleteBond" data-tooltip="{{localize "FEO.Bond.delete"}}" aria-label="{{localize "FEO.Bond.delete"}}">{{feoIcon "x"}}</button>
    </div>
    {{else}}
    <p class="empty">{{localize "FEO.Bond.none"}}</p>
    {{/each}}
    {{#if editable}}
    <button type="button" class="sup-add" data-action="addBond" data-tooltip="{{localize "FEO.Bond.addHint"}}">{{feoIcon "plus"}}{{localize "FEO.Bond.add"}}</button>
    {{/if}}

    {{else}}
    {{!-- Play mode: what the partners in range give together, and those partners only --}}
    <div class="sup-now{{#unless supports.near.length}} idle{{/unless}}">
      <span class="sup-heart">{{feoIcon "heart"}}</span>
      <div class="sup-lead">
        <b>{{localize "FEO.Bond.now"}}</b>
        <small>{{#if supports.near.length}}{{localize "FEO.Bond.nearCount" count=supports.near.length}}{{else}}{{#if bonds.length}}{{localize "FEO.Bond.nobodyNear" range=config.supportRange}}{{else}}{{localize "FEO.Bond.none"}}{{/if}}{{/if}}</small>
      </div>
      <div class="sup-totals">
        {{#each supports.totals as |part|}}<span><b>+{{part.amount}}</b><small>{{localize part.label}}</small></span>{{/each}}
      </div>
    </div>
    {{#each supports.near as |bond|}}
    <div class="sup-row near" data-bond="{{bond.index}}"
         data-tooltip="{{#each bond.parts as |part|}}+{{part.amount}} {{localize part.label}}. {{else}}{{localize "FEO.Bond.noBonus"}}. {{/each}}{{#if bond.ready}}{{localize "FEO.Bond.readyHint"}}{{else}}{{#if bond.pointsNext}}{{localize "FEO.Bond.progress" points=bond.points next=bond.pointsNext}}{{/if}}{{/if}}">
      <div class="sup-who">
        {{#if bond.img}}<img class="sup-token" src="{{bond.img}}" alt="">{{else}}<span class="sup-token">{{feoIcon bond.icon}}</span>{{/if}}
        <b>{{#if bond.name}}{{bond.name}}{{else}}{{localize "FEO.Bond.unnamed"}}{{/if}}</b>
        {{#if bond.kin}}<span class="sup-kin on" data-tooltip="{{localize "FEO.Bond.kin"}}" aria-label="{{localize "FEO.Bond.kin"}}">{{feoIcon "link"}}</span>{{/if}}
      </div>
      <span class="sup-pill{{#if bond.adjacent}} beside{{/if}}">{{#if bond.adjacent}}{{localize "FEO.Bond.adjacent"}}{{else}}{{localize "FEO.Bond.inRange"}}{{/if}}</span>
      <div class="sup-bar">
        {{#each bond.steps as |step|}}<span><i style="width: {{step.pct}}%"></i></span>{{/each}}
      </div>
      <span class="sup-rank{{#if bond.level}} on{{/if}}">{{localize bond.rankLabel}}</span>
    </div>
    {{/each}}
    {{/if}}
  </div>

  <div class="card">
    <h3>{{localize "FEO.Section.profile"}}</h3>
    <div class="facts">
      <label class="field"><span>{{localize "FEO.Unit.player"}}</span><input type="text" name="system.player" value="{{system.player}}"></label>
      <label class="field"><span>{{localize "FEO.Profile.age"}}</span><input type="text" name="system.profile.age" value="{{system.profile.age}}"></label>
      <label class="field"><span>{{localize "FEO.Profile.gender"}}</span><input type="text" name="system.profile.gender" value="{{system.profile.gender}}"></label>
      <label class="field"><span>{{localize "FEO.Profile.race"}}</span><input type="text" name="system.profile.race" value="{{system.profile.race}}"></label>
      <label class="field"><span>{{localize "FEO.Profile.homeland"}}</span><input type="text" name="system.profile.homeland" value="{{system.profile.homeland}}"></label>
      <label class="field"><span>{{localize "FEO.Profile.allegiance"}}</span><input type="text" name="system.profile.allegiance" value="{{system.profile.allegiance}}"></label>
      <label class="field"><span>{{localize "FEO.Profile.occupation"}}</span><input type="text" name="system.profile.occupation" value="{{system.profile.occupation}}"></label>
      <label class="field" {{#if affinity.effect}}data-tooltip="{{localize affinity.effect.text}} {{localize affinity.effect.mode}}"{{/if}}>
        <span>{{localize "FEO.Unit.affinity"}}</span>
        <select name="system.affinity">{{selectOptions config.affinities selected=system.affinity localize=true blank="–"}}</select>
      </label>
      {{#if affinity.rank}}
      <label class="field" data-tooltip="{{localize affinity.rank.text}} {{localize "FEO.Optional.affinityEffect.rank.hint"}}">
        <span>{{localize "FEO.Optional.affinityEffect.rank.label"}}</span>
        <select name="system.affinityRank">{{selectOptions affinity.rank.options selected=system.affinityRank localize=true blank="–"}}</select>
      </label>
      {{/if}}
      {{#if affinity.skill}}
      <label class="field" data-tooltip="{{localize affinity.skill.text}} {{localize "FEO.Optional.affinityEffect.skill.hint"}}">
        <span>{{localize "FEO.Optional.affinityEffect.skill.label"}}</span>
        <select name="system.affinitySkill">{{selectOptions affinity.skill.options selected=system.affinitySkill blank="–"}}</select>
      </label>
      {{/if}}
      <label class="field"><span>{{localize "FEO.Unit.specialQualities"}}</span><input type="text" name="system.specialQualities" value="{{system.specialQualities}}"></label>
      <label class="field" data-tooltip="{{localize "FEO.Army.hint"}}">
        <span>{{localize "FEO.Army.label"}}</span>
        <select name="system.army">{{selectOptions config.armies selected=systemSource.army localize=true blank=(localize "FEO.Army.auto")}}</select>
      </label>
    </div>
  </div>

  <div class="card">
    <h3>{{localize "FEO.Section.levelLines"}} <span class="aside">{{localize "FEO.LevelUp.lines.hint"}}</span></h3>
    <div class="pairs three">
      <label class="field" data-tooltip="{{localize "FEO.LevelUp.lines.greatHint" count=config.levelUp.lines.great}}">
        <span>{{localize "FEO.LevelUp.lines.great"}}</span>
        <input type="text" name="system.levelLines.great" value="{{system.levelLines.great}}" maxlength="{{config.levelUp.most.text}}">
      </label>
      <label class="field" data-tooltip="{{localize "FEO.LevelUp.lines.fairHint" count=config.levelUp.lines.fair}}">
        <span>{{localize "FEO.LevelUp.lines.fair"}}</span>
        <input type="text" name="system.levelLines.fair" value="{{system.levelLines.fair}}" maxlength="{{config.levelUp.most.text}}">
      </label>
      <label class="field" data-tooltip="{{localize "FEO.LevelUp.lines.poorHint" count=config.levelUp.lines.fair}}">
        <span>{{localize "FEO.LevelUp.lines.poor"}}</span>
        <input type="text" name="system.levelLines.poor" value="{{system.levelLines.poor}}" maxlength="{{config.levelUp.most.text}}">
      </label>
    </div>
  </div>

  <div class="cols story">
    <div class="card biography">
      <h3>{{localize "FEO.Unit.biography"}}</h3>
      {{#if editMode}}
      {{formInput systemFields.biography value=system.biography enriched=biographyHTML toggled=true}}
      {{else}}
      <div class="prose">{{{biographyHTML}}}</div>
      {{/if}}
    </div>
    <div class="card">
      <h3>{{localize "FEO.Section.linesVeils"}}</h3>
      <label class="field">
        <span>{{localize "FEO.Profile.lines"}}</span>
        <textarea name="system.profile.lines" rows="3">{{system.profile.lines}}</textarea>
      </label>
      <label class="field">
        <span>{{localize "FEO.Profile.veils"}}</span>
        <textarea name="system.profile.veils" rows="3">{{system.profile.veils}}</textarea>
      </label>
    </div>
  </div>

</section>
