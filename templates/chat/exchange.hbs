<div class="feo-card feo-exchange">
  <div class="versus">
    {{#each sides as |side|}}
    <div class="side" data-side="{{side.key}}" data-army="{{side.army}}">
      <div class="name">{{side.name}}</div>
      <div class="hp">{{#if side.changed}}<small>{{side.hpStart}} →</small> {{/if}}{{side.hp}}</div>
      <div class="bar {{side.state}}"><span class="left" style="width: {{side.left}}%"></span><span class="lost" style="width: {{side.lost}}%"></span></div>
    </div>
    {{/each}}
  </div>
  {{#if strikes.length}}
  <ol class="strikes">
    {{#each strikes as |strike|}}
    {{#if strike.round}}
    <li class="round"><span>{{strike.label}}</span></li>
    {{else if strike.answer}}
    <li class="{{strike.cls}}" data-side="{{strike.side}}" data-army="{{strike.army}}">
      <i class="fa-solid {{strike.icon}}"></i>
      <span class="who">{{strike.name}}</span>
      <span class="said">{{strike.label}}</span>
    </li>
    {{else}}
    <li class="{{strike.cls}}" data-side="{{strike.side}}" data-army="{{strike.army}}">
      <i class="fa-solid {{strike.icon}}"></i>
      <span class="who">{{strike.name}}</span>
      {{#if strike.crit}}<span class="tag">{{localize "FEO.Combat.critical"}}</span>{{/if}}
      {{#if strike.block}}<span class="tag blocked" data-tooltip="{{strike.blockTip}}"><i class="fa-solid fa-shield-halved"></i>{{strike.block}}</span>{{/if}}

      <span class="result">{{strike.result}}</span>
      {{#if strike.tags.length}}
      <span class="skills">{{#each strike.tags as |tag|}}<span class="tag skill {{tag.cls}}">{{tag.label}}</span>{{/each}}</span>
      {{/if}}
    </li>
    {{/if}}
    {{/each}}
  </ol>
  {{/if}}
  {{#if notable.length}}
  <ul class="notable">
    {{#each notable as |line|}}<li class="{{line.cls}}">{{line.label}}</li>{{/each}}
  </ul>
  {{/if}}
  {{#if inspect}}<button type="button" class="inspect" data-feo-inspect data-tooltip="{{localize "FEO.Chat.inspectHint"}}" aria-label="{{localize "FEO.Chat.inspect"}}"><i class="fa-solid fa-magnifying-glass"></i></button>{{/if}}
</div>
