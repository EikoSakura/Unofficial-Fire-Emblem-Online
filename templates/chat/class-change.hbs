<div class="feo-card feo-class-change"{{#if army}} data-army="{{army}}"{{/if}}>
  <header>
    <h3>{{title}}</h3>
    {{#if subtitle}}<p>{{subtitle}}</p>{{/if}}
    {{#if inspect}}<button type="button" class="inspect" data-feo-inspect data-tooltip="{{localize "FEO.Chat.inspectHint"}}" aria-label="{{localize "FEO.Chat.inspect"}}"><i class="fa-solid fa-magnifying-glass"></i></button>{{/if}}
  </header>
  {{#each groups as |group|}}
  <section>
    <h4>{{group.label}}</h4>
    <p class="chips">
      {{#each group.chips as |chip|}}<span class="chip {{chip.cls}}">{{chip.label}}{{#if chip.value}} <b>{{chip.value}}</b>{{/if}}</span>{{/each}}
    </p>
  </section>
  {{/each}}
  {{#each notes as |note|}}<p class="note">{{note}}</p>{{/each}}
</div>
