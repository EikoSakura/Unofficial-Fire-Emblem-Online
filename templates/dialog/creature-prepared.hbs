<p class="hint">{{#if one}}{{localize "FEO.Creature.prepared.hintOne"}}{{else}}{{localize "FEO.Creature.prepared.hint" most=most}}{{/if}}</p>
<div class="prepared-list">
  {{#each groups as |group|}}
  {{#if group.name}}<h4>{{group.name}}</h4>{{/if}}
  {{#each group.units as |unit|}}
  <label class="prepared-row">
    <img src="{{unit.img}}" alt="" width="32" height="32">
    <span class="who"><b>{{unit.name}}</b><small>{{#if unit.cls}}{{unit.cls}} · {{/if}}{{localize "FEO.Creature.prepared.level" level=unit.level}}</small></span>
    <input type="number" name="count.{{unit.id}}" value="0" min="0" max="{{../../most}}" step="1">
  </label>
  {{/each}}
  {{/each}}
</div>
<p class="tally" data-tally></p>
