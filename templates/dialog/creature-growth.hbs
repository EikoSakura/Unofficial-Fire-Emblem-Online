<p class="hint">{{localize "FEO.Creature.growth.hint" name=name points=points barred=barred}}</p>
<div class="growth-rows">
  {{#each rows as |row|}}
  <label class="growth-row{{#if row.barred}} barred{{/if}}">
    <span>{{row.label}}</span>
    <input type="number" name="growth.{{row.key}}" value="{{row.value}}" min="0" max="{{../points}}" step="{{../step}}" {{#if row.barred}}disabled{{/if}}>
  </label>
  {{/each}}
</div>
<p class="tally" data-tally></p>
