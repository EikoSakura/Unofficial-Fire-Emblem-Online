<div class="wm-heads">
  {{#if made}}
  <div class="wm-title">
    <b>{{name}}</b>
    <small>{{summary}}</small>
  </div>
  {{/if}}
  <div class="wm-corner">
    <div class="wm-bar">
      {{#if isGM}}
      {{#if made}}<button type="button" data-action="showAll" data-tooltip="{{localize "FEO.WorldMap.act.showAll"}}" aria-label="{{localize "FEO.WorldMap.act.showAll"}}">{{feoIcon "company"}}</button>{{/if}}
      <button type="button" data-action="create" data-tooltip="{{localize "FEO.WorldMap.act.edit"}}" aria-label="{{localize "FEO.WorldMap.act.edit"}}">{{feoIcon "brush"}}</button>
      {{/if}}
      <button type="button" data-action="travel" data-tooltip="{{localize "FEO.WorldMap.act.window"}}" aria-label="{{localize "FEO.WorldMap.act.window"}}">{{feoIcon "shrink"}}</button>
      <button type="button" data-action="close" data-tooltip="{{localize "FEO.WorldMap.act.close"}}" aria-label="{{localize "FEO.WorldMap.act.close"}}">{{feoIcon "x"}}</button>
    </div>
    {{#if made}}
    <div class="wm-legend">
      {{#each legend as |nation|}}
      <button type="button" data-action="spot" data-nation="{{nation.id}}" aria-pressed="{{nation.on}}"
              data-tooltip="{{localize "FEO.WorldMap.spot"}}"><i style="background: {{nation.color}}"></i>{{nation.name}}</button>
      {{/each}}
      <div class="wm-key">
        <span><i class="wm-key-battle"></i>{{localize "FEO.WorldMap.key.battle"}}</span>
        <span><i class="wm-key-visited"></i>{{localize "FEO.WorldMap.key.visited"}}</span>
        <span><i class="wm-key-known"></i>{{localize "FEO.WorldMap.key.known"}}</span>
      </div>
    </div>
    {{/if}}
  </div>
</div>
