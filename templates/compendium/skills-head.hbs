<section class="cp-head v-skills">
  <div class="cp-head-row">
    <div class="txt">
      <div class="cp-eyebrow">{{eyebrow}}</div>
      <h2>{{localize "FEO.Compendium.skills.title"}}</h2>
      <p>{{localize "FEO.Compendium.skills.lead"}}</p>
    </div>
    <div class="cp-tools">
      <label class="cp-search">
        {{feoIcon "search"}}
        <input type="search" data-search="skills" value="{{query}}" autocomplete="off"
               placeholder="{{localize "FEO.Compendium.skills.search"}}"
               aria-label="{{localize "FEO.Compendium.skills.search"}}">
      </label>
    </div>
  </div>
</section>
