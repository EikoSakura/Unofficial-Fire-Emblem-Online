<header class="cp-top">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="feo-crest-shine" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".3"/>
        <stop offset=".5" stop-color="#fff" stop-opacity="0"/>
        <stop offset="1" stop-color="#000" stop-opacity=".22"/>
      </linearGradient>
    </defs>
  </svg>

  <div class="cp-masthead">
    <svg class="cp-mast-crest" viewBox="0 0 50 56" aria-hidden="true" focusable="false">
      <g fill="none" stroke="#f0d48a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="25" cy="3.5" r="1.8" fill="#f0d48a"/>
        <path d="M25 5.5v5M18 10.5h14"/>
        <path d="M25 49.5v5l-2.3-2.5M25 54.5l2.3-2.5"/>
        <path d="M7 11h36v18c0 11-7 17.5-18 22C14 46.5 7 40 7 29V11z" fill="#0f2146" stroke-width="2.2"/>
        <path d="M25 22c-2.8-2-6.5-2.8-11-2.5v13.5c4.5-.3 8.2.5 11 2.5 2.8-2 6.5-2.8 11-2.5V19.5c-4.5-.3-8.2.5-11 2.500zM25 22v13.5" stroke="#f8f1de" stroke-width="1.7"/>
        <path d="M17.5 24.5c1.7 0 3.2.3 4.5.9M17.5 28c1.7 0 3.2.3 4.5.9M32.5 24.500c-1.7 0-3.2.3-4.5.9M32.5 28c-1.7 0-3.2.3-4.5.9" stroke="#f8f1de" stroke-width="1.1" opacity=".7"/>
        <path d="M25 40.5l1.3 2.2 2.5.4-1.8 1.8.4 2.5-2.4-1.2-2.4 1.2.4-2.5-1.8-1.8 2.5-.4 1.3-2.200z" fill="#f0d48a" stroke="none"/>
      </g>
    </svg>
    <div class="cp-mast-title">
      <small>{{localize "FEO.Compendium.over"}}</small>
      <b>{{localize "FEO.Compendium.title"}}</b>
    </div>
    <div class="cp-mast-rule"></div>
    <div class="cp-mast-motto"><b>{{localize "FEO.Compendium.motto"}}</b>{{localize "FEO.Compendium.mottoSub"}}</div>
  </div>

  <nav class="cp-pennants" role="tablist" aria-label="{{localize "FEO.Compendium.sections"}}">
    {{#each tabs as |tab|}}
    <button type="button" class="cp-pennant" role="tab" data-action="view" data-view="{{tab.id}}"
            aria-selected="{{tab.selected}}">
      <span class="seal">{{feoIcon tab.icon}}</span>
      <span><b>{{tab.label}}</b><small class="num">{{tab.count}}</small></span>
    </button>
    {{/each}}
  </nav>
</header>
