<div class="hud-slot hud-hover">
  {{#with hover}}
  <section class="hud-panel hc" style="{{style}}" aria-label="{{localize "FEO.Hud.hovered"}}">
    <div class="hc-head cloth" data-army="{{army}}"><b>{{name}}</b><span>{{className}} · <em class="{{#if synced}}sync{{/if}}"{{#if synced}} data-tooltip="{{synced}}"{{/if}}>{{#if synced}}{{feoIcon "sync"}}{{/if}}{{localize "FEO.Hud.level"}} {{level}}</em></span></div>
    <div class="hc-body">
      <div class="hc-hp{{#if hp.temp}} lent{{/if}}" data-tone="{{hp.tone}}"{{#if hp.tip}} data-tooltip="{{hp.tip}}"{{/if}}><span>{{localize "FEO.Stat.hp.abbr"}}</span><div class="bar"><i style="width:{{hp.percent}}%"></i>{{#if hp.temp}}<em style="left:{{hp.percent}}%;width:{{hp.tempPercent}}%"></em>{{/if}}</div><b>{{hp.value}} / {{hp.max}}</b></div>
      {{#if stagger}}<div class="hc-hp hc-stagger"><span>{{localize "FEO.Optional.stagger.abbr"}}</span><div class="bar stagger{{#if stagger.staggered}} staggered{{/if}}"><i style="width:{{stagger.percent}}%"></i></div><b>{{stagger.value}} / {{stagger.max}}</b></div>{{/if}}
      <div class="hc-row">
        {{#if weapon}}<img src="{{weapon.img}}" alt=""><b>{{weapon.name}}</b> {{localize "FEO.Hud.range"}} {{weapon.range}}{{else}}{{feoIcon "x"}}{{localize "FEO.Combat.unarmed"}}{{/if}}
        {{#if stateLabel}}<span class="end">{{stateLabel}}</span>{{/if}}
      </div>
      {{#if tile}}
      <div class="hc-row">{{feoIcon tile.icon}}<b>{{tile.name}}</b>{{#if tile.elevation}} ▲{{tile.elevation}}{{/if}} <span>{{tile.bonus}}</span></div>
      {{/if}}
      {{#if conditions.length}}
      <div class="hc-row wrap">{{#each conditions as |condition|}}<span class="chip{{#if condition.tone}} {{condition.tone}}{{/if}}">{{#if condition.arrow}}<i class="arrow">{{condition.arrow}}</i>{{/if}}{{#if condition.img}}<img src="{{condition.img}}" alt="">{{/if}}{{condition.label}}{{#if condition.count}} <b class="count">{{condition.count}}</b>{{/if}} <small>{{condition.turns}}</small></span>{{/each}}</div>
      {{/if}}
      {{#with versus}}
      {{#if out}}
      <div class="hc-hint">{{out}}</div>
      {{else}}
      <div class="hc-fc">
        <small>{{lead}}</small>
        {{#if blocked}}{{blocked}}{{else}}<b>{{damage}}</b>{{#if times}} × {{times}}{{/if}} {{localize "FEO.Hud.dmg"}} · <b>{{hit}}</b> {{localize "FEO.Combat.hit"}} · <b>{{crit}}</b> {{localize "FEO.Combat.critAbbr"}}{{/if}}
        <small>{{counter}}</small>
      </div>
      <div class="hc-hint">{{localize "FEO.Hud.clickForecast"}}</div>
      {{/if}}
      {{/with}}
    </div>
  </section>
  {{/with}}
</div>
