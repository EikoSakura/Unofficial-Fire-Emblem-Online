<div class="hud-slot hud-dock">
  {{#with dock}}
  <section class="hud-panel dock" aria-label="{{localize "FEO.Hud.selected"}}">
    <div class="dk-banner cloth" data-army="{{army}}">
      <div class="dk-portrait"><img src="{{img}}" alt=""><span class="lv{{#if synced}} sync{{/if}}"{{#if synced}} data-tooltip="{{synced}}"{{/if}}>{{#if synced}}{{feoIcon "sync"}}{{/if}}{{localize "FEO.Hud.level"}} {{level}}</span></div>
      <div class="dk-id"><div class="dk-name">{{name}}</div><div class="dk-class">{{className}}</div></div>
      <div class="dk-hp{{#if hp.temp}} lent{{/if}}" data-tone="{{hp.tone}}"{{#if hp.tip}} data-tooltip="{{hp.tip}}"{{/if}}>
        <div>{{localize "FEO.Stat.hp.abbr"}}<b>{{hp.value}} <span>/ {{hp.max}}</span></b></div>
        <div class="bar"><i style="width:{{hp.percent}}%"></i>{{#if hp.temp}}<em style="left:{{hp.percent}}%;width:{{hp.tempPercent}}%"></em>{{/if}}</div>
        {{#if stagger}}<div class="bar stagger{{#if stagger.staggered}} staggered{{/if}}" data-tooltip="{{stagger.label}}"><i style="width:{{stagger.percent}}%"></i></div>{{/if}}
      </div>
      <div class="dk-chips">
        {{#each conditions as |condition|}}
        <span class="chip{{#if condition.tone}} {{condition.tone}}{{/if}}"{{#if condition.tip}} data-tooltip="{{condition.tip}}"{{/if}}>{{#if condition.arrow}}<i class="arrow">{{condition.arrow}}</i>{{/if}}{{#if condition.img}}<img src="{{condition.img}}" alt="">{{/if}}{{condition.label}}{{#if condition.count}} <b class="count">{{condition.count}}</b>{{/if}} <small>{{condition.turns}}</small>{{#if condition.action}}<button type="button" class="chip-act" data-action="{{condition.action}}" data-tooltip="{{condition.hint}}">{{condition.button}}</button>{{/if}}</span>
        {{else}}
        <span class="chip none">{{localize "FEO.Hud.noConditions"}}</span>
        {{/each}}
      </div>
    </div>

    <div class="dk-mid">
      {{#if weapon}}
      <button type="button" class="dk-weapon" data-action="equip" {{#if equipOpen}}aria-expanded="true"{{/if}} data-tooltip="{{localize "FEO.Hud.flyout.equipFree"}}">
        <span class="ico"><img src="{{weapon.img}}" alt="">{{#if weapon.mark}}<img class="lent-mark" src="{{weapon.mark}}" alt="" data-tooltip="{{weapon.lender}}">{{/if}}</span>
        <span class="txt"><span class="nm">{{weapon.name}}</span>
          <span class="sub">{{#if weapon.staff}}{{localize "FEO.WeaponType.staff"}}{{else}}{{localize "FEO.Hud.might"}} <b>{{weapon.might}}</b> · {{localize "FEO.Combat.hit"}} <b>{{weapon.hit}}</b> · {{localize "FEO.Combat.critAbbr"}} <b>{{weapon.crit}}</b>{{/if}} · {{localize "FEO.Hud.range"}} <b>{{weapon.range}}</b></span></span>
        <span class="uses">{{weapon.uses}}{{#if canSwap}}{{feoIcon "swap"}}{{/if}}</span>
      </button>
      {{else}}
      <button type="button" class="dk-weapon" data-action="equip" {{#if equipOpen}}aria-expanded="true"{{/if}}>
        <span class="ico">{{feoIcon "x"}}</span>
        <span class="txt"><span class="nm">{{localize "FEO.Combat.unarmed"}}</span><span class="sub">{{localize "FEO.Exchange.blocked.unarmed"}}</span></span>
        <span class="uses">{{#if canSwap}}{{feoIcon "swap"}}{{/if}}</span>
      </button>
      {{/if}}
      <div class="dk-nums{{#if blocks}} six{{/if}}">

        {{#each numbers as |number|}}<div{{#if number.tip}} data-tooltip="{{number.tip}}"{{/if}}><b>{{number.value}}</b><span>{{number.label}}</span></div>{{/each}}
      </div>
      <div class="dk-foot">
        <span class="lbl">{{localize "FEO.Stat.mov.abbr"}}</span>
        <span class="movpips">{{#each mov.pips as |pip|}}<i class="{{#if pip.off}}off{{/if}}"></i>{{/each}}</span>
        <span>{{mov.left}}</span>
        {{#if canUndo}}<button type="button" class="btn small" data-action="undo">{{feoIcon "left"}}{{localize "FEO.Hud.undo"}}</button>{{/if}}
        {{#if tile}}<span class="ground" data-tooltip="{{tile.bonus}}">{{feoIcon tile.icon}}<b>{{tile.name}}</b>{{#if tile.elevation}} ▲{{tile.elevation}}{{/if}}</span>{{/if}}
      </div>
    </div>

    <div class="dk-actions">
      <div class="dk-status {{#if status.locked}}lock{{/if}}">{{feoIcon status.icon}}<span>{{status.text}}</span>
        {{#if canSpend}}<button type="button" class="btn small" data-action="spendRound" data-tooltip="{{localize "FEO.Hud.spendHint"}}">{{localize "FEO.Hud.spend"}}</button>{{/if}}
        {{#if status.pass}}<button type="button" class="btn small" data-action="pass">{{localize "FEO.Forced.pass"}}</button>{{/if}}
        {{#if status.sing}}<button type="button" class="btn small" data-action="sing">{{localize "FEO.Refresh.sing"}}</button>{{/if}}
        {{#if status.confirm}}<button type="button" class="btn small" data-action="confirmArea">{{localize "FEO.Area.confirm"}}</button>{{/if}}
      </div>
      <div class="acts{{#if wide}} wide{{/if}}" style="--acts: {{columns}}">
        {{#each actions as |action|}}
        <button type="button" class="act {{#if action.primary}}primary{{/if}} {{#if action.on}}on{{/if}}" data-action="{{action.id}}"
                {{#if action.disabled}}disabled{{/if}} {{#if action.open}}aria-expanded="true"{{/if}}
                {{#if action.tooltip}}data-tooltip="{{action.tooltip}}"{{/if}}>{{feoIcon action.icon}}{{action.label}}</button>
        {{/each}}
      </div>
      {{#if showTurn}}
      <div class="dk-turn">{{localize "FEO.Hud.turn"}}
        <button type="button" class="btn small" data-action="startTurn" data-tooltip="{{localize "FEO.Rail.startTurnHint"}}">{{localize "FEO.Rail.startTurn"}}</button>
        <button type="button" class="btn small" data-action="endTurn" data-tooltip="{{localize "FEO.Rail.endTurnHint"}}">{{localize "FEO.Rail.endTurn"}}</button>
      </div>
      {{/if}}
    </div>

    {{#with flyout}}
    <div class="fly {{side}}">
      <h5>{{title}} <span>{{aside}}</span></h5>
      <div class="fly-rows">
        {{#each rows as |row|}}
        {{#if row.post}}<div class="fly-line">{{/if}}
        <button type="button" class="fly-row{{#if row.on}}on{{/if}}{{#if row.watch}} watch{{/if}}{{#if row.wait}} wait{{/if}}{{#if row.dim}} dim{{/if}}" data-action="{{row.action}}" data-item-id="{{row.id}}" {{#if row.form}}data-form="{{row.form}}" {{/if}}{{#if row.disabled}}disabled{{/if}}{{#if row.dim}} aria-disabled="true"{{/if}}{{#if row.tip}} data-tooltip="{{row.tip}}"{{/if}}>
          <span class="ico">{{#if row.img}}<img src="{{row.img}}" alt="">{{else}}{{#if row.icon}}{{feoIcon row.icon}}{{/if}}{{/if}}{{#if row.mark}}<img class="lent-mark" src="{{row.mark}}" alt="" data-tooltip="{{row.tip}}">{{/if}}</span>
          <span class="txt"><span class="nm">{{row.name}}</span><span class="sub">{{row.sub}}</span></span>
          <span class="end">{{row.end}}</span>
        </button>
        {{#if row.post}}
        <button type="button" class="fly-post" data-action="postItem" data-item-id="{{row.id}}" data-tooltip="{{localize "FEO.Item.post"}}" aria-label="{{localize "FEO.Item.post"}}">{{feoIcon "chat"}}</button>
        </div>
        {{/if}}
        {{/each}}
      </div>
      {{#if empty}}<p>{{empty}}</p>{{/if}}
      {{#if foot}}<p>{{foot}}</p>{{/if}}
    </div>
    {{/with}}
  </section>
  {{/with}}
</div>
